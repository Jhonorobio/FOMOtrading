{
  "expo": {
    "name": "Paper Terminal",
    "slug": "expo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "paper-terminal",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fomotrading.app",
      "adaptiveIcon": {
        "backgroundColor": "#060510",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "networkSecurityConfig": "./android/app/src/main/res/xml/network_security_config.xml"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "defaultServerUrl": "https://mapping-cottages-borough-acm.trycloudflare.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "00d6910e-2a3e-4358-8169-ff606f87106b"
      }
    },
    "owner": "jhonorobio"
  }
}
