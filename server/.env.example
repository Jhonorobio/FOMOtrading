# Paper Terminal - self-hosted server configuration
# Copy this file to .env and edit the values.

PORT=3001
NODE_ENV=development

# JWT secret used to sign session tokens. Change this to a long random string.
JWT_SECRET=cambia_esta_clave_secreta_por_algo_largo_y_aleatorio

# Paper trading economics (can be tuned per deployment)
FEE_RATE=0.001
SLIPPAGE_RATE=0.20
MIN_TRADE_USD=5
MAX_TRADE_USD=100000

# Starting capital presets shown when creating/resetting an account (USD)
STARTING_BALANCE_PRESETS=1000,5000,10000,25000,50000,100000
MIN_STARTING_BALANCE=1
MAX_STARTING_BALANCE=1000000

# Minimum age shown in the consent gate
MINIMUM_AGE=18

# ── Photon Graduados (memescope col3) ─────────────────────────────────────
# Cookie _photon_ta de photon-sol.tinyastro.io (llena para usar la tuya en vez de la embebida).
# PHOTON_TA=
# Proxy propio del poller (vacío = cae al proxy compartido de /api/proxy, y sin
# proxyConsulta directo). Solo http:// y https://.
# PHOTON_GRADS_PROXY=
# Filtros de arranque de la columna Graduated (JSON con la forma de los campos del
# editor; luego se gestionan por PUT /api/photon-grads/config):
# PHOTON_GRADS_FILTERS={"mktCap":{"min":"150"},"holders":{"min":"50"}}

# How long (in hours) to remember that a Graduados token was already notified via
# Telegram. Within this window the token will NOT be notified again even if the
# Mobula feed drops it and re-adds it. Default: 168 (7 days).
TELEGRAM_NOTIFY_TTL_HOURS=168

# Telemetry.io live market data (REQUIRED).
# Option A: Direct access token (simplest). Paste the Bearer token from app.telemetry.io
# Network tab → /data/market_data_batch → Authorization header.
TELEMETRY_ACCESS_TOKEN=tu_access_token_de_telemetry_aqui
#
# Option B: Refresh token (auto-rotates). Get from /v1/auth/refresh response.
# TELEMETRY_REFRESH_TOKEN=tu_refresh_token_de_telemetry_aqui
# Set either one, or POST /api/market/telemetry/token without restarting.
