# Paper Terminal - self-hosted server configuration
# Copy this file to .env and edit the values.

PORT=3001
NODE_ENV=development

# JWT secret used to sign session tokens. Change this to a long random string.
JWT_SECRET=cambia_esta_clave_secreta_por_algo_largo_y_aleatorio

# Paper trading economics (can be tuned per deployment)
FEE_RATE=0.001
SLIPPAGE_RATE=0.005
MIN_TRADE_USD=5
MAX_TRADE_USD=100000

# Starting capital presets shown when creating/resetting an account (USD)
STARTING_BALANCE_PRESETS=1000,5000,10000,25000,50000,100000
MIN_STARTING_BALANCE=1
MAX_STARTING_BALANCE=1000000

# Minimum age shown in the consent gate
MINIMUM_AGE=18

# Telemetry.io live market data (REQUIRED). Set your Bearer token from app.telemetry.io
# This is the only market data provider used - no fallback.
TELEMETRY_BEARER_TOKEN=tu_token_de_telemetry_aqui
