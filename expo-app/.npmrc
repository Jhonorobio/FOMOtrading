# expo SDK 58 pins react@19.3.0 while react-dom@19.3.1 (auto-installed as an
# optional peer of expo-router) declares react ^19.3.1 as its peer dependency.
# npm's strict peer resolution rejects that combo; legacy-peer-deps matches how
# npm 6 behaved (skip optional-peer conflicts) and how the lockfile was generated.
legacy-peer-deps=true
